{
  "version": 2,
  "builds": [
    {
      "src": "public/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "api/giveaway.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/giveaway",
      "dest": "/api/giveaway.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}